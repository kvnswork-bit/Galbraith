rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site_content/{contentId} {
      // Allow public read and write access for site content
      allow read: if true;
      allow write: if true;
    }
    match /projects/{projectId} {
      // Allow reading and writing individual project documents
      allow read: if true;
      allow write: if true;
    }
    match /sections/{sectionId} {
      // Allow reading and writing section documents
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
